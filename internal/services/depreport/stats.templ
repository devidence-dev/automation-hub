package depreport

// StatsPanel is the panel of a tab: the eyebrow, the big number of listed updates, the sub line, the
// distribution bar and the legend. From 601px the number sits beside the bar and the legend.
templ StatsPanel(s StatsView) {
	<div class="glass mt-3.5 rounded-[26px] p-6 [--glass-bg:var(--glass-strong)] [--glass-shadow:var(--shadow-lg)]">
		<p class="m-0 text-xs font-semibold tracking-[.12em] text-accent uppercase">{ s.Eyebrow }</p>
		<div class="mt-[18px] grid grid-cols-1 items-end gap-[18px] min-[601px]:grid-cols-[auto_minmax(0,1fr)] min-[601px]:gap-7">
			<div>
				<p class="m-0 text-[72px] leading-[0.9] font-light tracking-[-0.04em] tabular-nums">{ s.Big }</p>
				<p class="mt-2.5 mb-0 text-[13px] text-muted">{ s.Sub }</p>
			</div>
			<div>
				@DistributionBar(s.Segments)
				@Legend(s.Legend)
			</div>
		</div>
	</div>
}

// DistributionBar is the stacked bar of the update types, patch, minor and major. Each segment is as
// wide as its share of the listed updates; a zero type has no segment.
templ DistributionBar(segments []BarSegment) {
	<div class="flex h-2 gap-[3px] overflow-hidden rounded-full">
		for _, seg := range segments {
			<span class={ "bar-seg " + toneOf(seg.Type) } style={ "width:" + seg.Percent }></span>
		}
	</div>
}

// Legend lists each type with its count. A zero count is shown.
templ Legend(items []LegendItem) {
	<div class="mt-3 flex flex-wrap gap-[18px]">
		for _, it := range items {
			<span class="flex items-center gap-[7px] text-xs text-ink-2">
				<i aria-hidden="true" class={ "swatch size-[7px] rounded-full " + toneOf(it.Type) }></i>
				{ it.Label }
				<b class="font-mono text-xs font-medium text-ink">{ it.Count }</b>
			</span>
		}
	</div>
}

// SummaryText is the line between the panel and the repo cards: the bold part, then the rest.
templ SummaryText(s SummaryLine) {
	<p class="mx-1.5 mt-[26px] mb-3 text-muted">
		<b class="font-semibold text-ink">{ s.Bold }</b>
		if s.Rest != "" {
			{ " " + s.Rest }
		}
	</p>
}
