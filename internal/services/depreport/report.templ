package depreport

// ReportDocument is the whole document: the head with the embedded stylesheet and the favicon, the header,
// the tabs, the errors card, the export dialog, the live region that announces copies and the report script
// (openspec design D2, D20). The document has no data-theme on <html>: the theme starts on Auto. Every
// script and style are embedded, so the file needs no other file.
templ ReportDocument(view documentView) {
	<!doctype html>
	<html lang={ view.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ view.Title }</title>
			<link rel="icon" href={ templ.SafeURL(faviconHref()) }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"/>
			@templ.Raw("<style>" + ReportCSS + "</style>")
		</head>
		<body class="app-bg font-sans text-sm leading-[1.4] antialiased">
			<div class="mx-auto max-w-[760px] px-5 pt-7 pb-12">
				<h1 class="sr-only">{ view.Title }</h1>
				@Header(view.Header)
				<main>
				@Tabs(view)
				if view.Errors.Chip != "" {
					@ErrorsCard(view.Errors)
				}
				</main>
				if len(view.Export.Sections) > 0 {
					@ExportDialog(view.Export, view.Labels)
				}
			</div>
			<p id="copy-status" data-copied-text={ view.Labels.Copied } data-copied-before={ view.Labels.CopiedBefore } role="status" class="sr-only"></p>
			@templ.Raw("<script>" + reportScript + "</script>")
		</body>
	</html>
}

// Header arranges the logo and theme above the scan stamp and export on narrow screens.
templ Header(view HeaderView) {
	<header class="grid grid-cols-[1fr_auto] [grid-template-areas:'logo_theme'_'meta_meta'] min-[601px]:grid-cols-[auto_1fr_auto] min-[601px]:[grid-template-areas:'logo_meta_theme'] items-center gap-4 px-1 pt-1">
		<div class="[grid-area:logo]">
			@Logo()
		</div>
		<div class="[grid-area:theme]">
			@ThemeControl(view.Labels)
		</div>
		<div class="[grid-area:meta] flex min-w-0 items-center gap-2 min-[601px]:justify-end">
			<span class="glass-pill min-w-0 flex-1 gap-2 font-mono text-xs text-muted min-[601px]:flex-initial">
				<i aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-patch dot-glow [--dot-ring:var(--patch-glow)]"></i>
				<time class="min-w-0 flex-1 truncate" datetime={ view.ScanDateTime } title={ view.ScanTimestamp }>{ view.ScanTimestamp }</time>
			</span>
			if view.HasExport {
				@ExportButton(view.Labels)
			}
		</div>
	</header>
}
