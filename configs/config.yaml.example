server:
  address: ":8080"

telegram:
  bot_token: "{{TELEGRAM_BOT_TOKEN}}"

workflow_bot:
  # Bot already used by github-runner to notify workflow results.
  bot_token: "{{GITHUB_RUNNER_TELEGRAM_BOT_TOKEN}}"

github:
  token: "{{GITHUB_TOKEN}}"

workflows:
  # Optional "schedule" on any entry: a 5-field cron expression (minute hour
  # day-of-month month day-of-week) evaluated in America/Guayaquil. The hub
  # dispatches the workflow at those times. Omit it to run only from Telegram.
  - command: "run_cleanup"
    description: "Cleanup unused images"
    owner: "devidence-dev"
    repo: "workflows"
    workflow_file: "ops-github-runner-cleanup.yml"
    ref: "main"
    allowed_chat_ids: ["{{TELEGRAM_ADMIN_CHAT_ID}}"]

restarts:
  # Equivalent to `kubectl rollout restart deployment/github-runner -n infrastructure`.
  # Fixes the stale docker.sock/containerd.sock bind that follows a Docker or k3s
  # package upgrade on the host — the pod needs to remount the current socket.
  - command: "restart_runner"
    description: "Restart the github-runner pod (fixes stale docker/containerd socket)"
    namespace: "infrastructure"
    deployment: "github-runner"
    allowed_chat_ids: ["{{TELEGRAM_ADMIN_CHAT_ID}}"]

jobs:
  # Creates a one-off Kubernetes Job from a suspended CronJob template, like
  # `kubectl create job --from=cronjob/dependency-report -n internal-apps`.
  # Needs RBAC in the homelab repo: cronjobs get + jobs create in the namespace.
  # Optional "schedule" works like it does for workflows.
  - command: "run_dependency_report"
    description: "Run the dependency report (Renovate lookup)"
    namespace: "internal-apps"
    cronjob: "dependency-report"
    allowed_chat_ids: ["{{TELEGRAM_ADMIN_CHAT_ID}}"]
    schedule: "0 9 * * 1"  # Mondays at 09:00

# Enables POST /webhook/dependency-report, called by the Job's reporter container
# (multipart: exit_code, pod, log_tail, report; header X-Report-Token). The report
# goes to telegram_chat_id through the "telegram" bot above: one message per repo
# (or "todo al día"), then one HTML document, dependency-report-<YYYY-MM-DD>.html.
# The document loads Bootstrap from cdn.jsdelivr.net when opened in a browser.
# Values are Infisical references resolved inside CONFIG_YAML (shown here as ${...} placeholders).
# Do NOT quote the forks reference: it holds a JSON array, so unquoted YAML reads a
# list. Quoting it turns the array into a string and config loading fails.
dependency_report:
  webhook_token: "${DEPENDENCY_REPORT_TOKEN}"
  telegram_chat_id: "{{TELEGRAM_DEPENDENCY_REPORT_CHAT_ID}}"
  forks: ${DEPENDENCY_REPORT_FORKS}  # e.g. ["devidence-dev/discord-tts-bot"]

email:
  host: "{{EMAIL_HOST}}"
  port: {{EMAIL_PORT}}
  username: "{{EMAIL_USERNAME}}"
  password: "{{EMAIL_PASSWORD}}"
  polling_interval: 20 # Polling interval in seconds
  services:
    - name: "cloudflare"
      config:
        email_from: "noreply@notify.cloudflare.com"
        email_subject:
          - "devidence.dev"
        telegram_chat_id: "{{TELEGRAM_CLOUDFLARE_CHAT_ID}}"
        telegram_message: "🛡️ Cloudflare App Code: \n```%s```"
        # code_pattern: "\\b\\d{6}\\b"  # Optional: custom regex pattern
        # mark_as_read: false  # Optional: leave the email unread after processing (default: true)
    - name: "openai"
      config:
        email_from: "noreply@tm.openai.com"
        email_subject:
          - "Your temporary ChatGPT login code"
          - "Tu código temporal de inicio de sesión de ChatGPT"
        telegram_chat_id: "{{TELEGRAM_OPENAI_CHAT_ID}}"
        telegram_message: "🤖 ChatGPT Code: ```%s```"
        # HTML email body has inline CSS hex colors (e.g. "#202123") that a
        # bare \b\d{6}\b would greedily match before the real code. The
        # leading [^#] + capture group rules those out (see generic.go's
        # extractCode: it prefers submatch group 1 when the pattern has one).
        code_pattern: "[^#]\\b(\\d{6})\\b"
    - name: "perplexity"
      config:
        email_from: "team@mail.perplexity.ai"
        email_subject:
          - "Sign in to Perplexity"
          - "Inicia sesión en Perplexity"
        telegram_chat_id: "{{TELEGRAM_PERPLEXITY_CHAT_ID}}"
        telegram_message: "🔮 Perplexity Code: ```%s```"
        # code_pattern: "\\b[a-zA-Z0-9]{5}-[a-zA-Z0-9]{5}\\b"  # Optional

hook:
  - name: "qbittorrent"
    path: "/webhook/qbittorrent"
    config:
      telegram_chat_id: "{{TELEGRAM_QBITTORRENT_CHAT_ID}}"
      telegram_message: "📥 **Download completed successfully!** 🎬 \n🔍 **Name:**  \n%s\n📍 **Path:**  \n%s"
  # - name: "other-webhook"
  #   path: "/webhook/other-webhook"
  #   config:
  #     telegram_chat_id: "{{TELEGRAM_OTHER_CHAT_ID}}"
  #     telegram_message: "Custom message: %s"
