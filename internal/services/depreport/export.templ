package depreport

// ExportButton opens the export dialog and shows its catalog label at every width.
templ ExportButton(labels chromeLabels) {
	<button type="button" class="btn glass-pill shrink-0 gap-1.5 text-xs font-medium text-ink hover:[--glass-bg:var(--btn-hover)]" aria-haspopup="dialog" aria-controls="export-dialog" aria-label={ labels.ExportButton } title={ labels.ExportButton } data-export-open>
		@Icon("export", "")
		<span>{ labels.ExportButton }</span>
	</button>
}

// exportAction is one action of the export dialog. typ is the button type: copy and download are plain
// buttons, close submits the dialog form. attrs carries the data attributes that report.js reads, and the
// children are the label. The hover applies only when enabled, so a disabled action keeps its surface. The
// group class lets the copy label swap for its copied text.
templ exportAction(typ string, attrs templ.Attributes) {
	<button type={ typ } class="btn group inline-flex items-center gap-1.5 rounded-full border border-btn-edge bg-btn-bg px-3.5 py-2 text-[13px] font-medium text-ink enabled:hover:bg-btn-hover" { attrs... }>{ children... }</button>
}

// ExportDialog is the modal of the export: one section per tab with listed updates, each with a section
// checkbox and one checkbox per repo, then the copy, download and close actions. An icon-only close button
// beside the title closes it too, through its own dialog form. report.js reads the data
// attributes; the YAML fragments are escaped as attribute values, so report text stays inert.
templ ExportDialog(view ExportView, labels chromeLabels) {
	<dialog id="export-dialog" data-export-dialog aria-labelledby="export-title" data-header={ view.Header } data-file-name={ view.FileName } class="glass export-dialog [--glass-bg:var(--glass-strong)] [--glass-shadow:var(--shadow-strong)]">
		<div class="flex items-start justify-between gap-3">
			<h2 id="export-title" class="m-0 text-[15px] font-semibold">{ labels.ExportTitle }</h2>
			<form method="dialog">
				<button type="submit" class="btn icon-btn" aria-label={ labels.ExportClose } title={ labels.ExportClose } data-export-dismiss>@Icon("close", "")</button>
			</form>
		</div>
		for _, s := range view.Sections {
			<fieldset data-export-section data-key={ s.Key } class="mt-4 min-w-0 border-0 p-0">
				<legend class="mb-1.5 p-0 text-[13px] font-semibold">
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input type="checkbox" data-export-all checked class="cursor-pointer"/>
						{ s.Label }
					</label>
				</legend>
				<ul class="m-0 flex list-none flex-col gap-1 p-0 pl-6">
					for _, r := range s.Repos {
						<li>
							<label title={ r.Repo } class="inline-flex cursor-pointer items-center gap-2 text-[13px]">
								<input type="checkbox" data-export-repo data-yaml={ r.YAML } checked class="cursor-pointer"/>
								{ r.Short }
								if r.Note != "" {
									<span class="text-xs text-muted">{ r.Note }</span>
								}
							</label>
						</li>
					}
				</ul>
			</fieldset>
		}
		<div class="mt-5 flex flex-wrap items-center gap-2">
			@exportAction("button", templ.Attributes{"data-export-copy": true, "data-copied-text": labels.Copied}) {
				@Icon("copy", "group-data-[state=copied]:hidden")
				@Icon("check", "hidden group-data-[state=copied]:block")
				<span class="group-data-[state=copied]:hidden">{ labels.ExportCopy }</span><span class="hidden group-data-[state=copied]:inline">{ labels.Copied }</span>
			}
			@exportAction("button", templ.Attributes{"data-export-download": true}) {
				@Icon("download", "")
				{ labels.ExportDownload }
			}
			<form method="dialog" class="ml-auto">
				@exportAction("submit", templ.Attributes{"data-export-close": true}) {
					@Icon("close", "")
					{ labels.ExportClose }
				}
			</form>
		</div>
		<p role="status" class="sr-only" data-export-status></p>
	</dialog>
}
