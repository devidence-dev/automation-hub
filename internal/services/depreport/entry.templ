package depreport

// FileGroup is one package file of a repo card: its entries, then its location once, on its own line.
templ FileGroup(f FileGroupView, labels rowLabels) {
	<div class="border-b border-line pt-[5px] pb-2 last:border-b-0">
		<ul role="list">
			for _, e := range f.Entries {
				@DepRow(e, labels)
			}
		</ul>
		<p class="mt-1 mb-0 flex items-center gap-1.5 font-mono text-xs text-muted">
			@Icon("file", "shrink-0 text-muted-2")
			<span class="min-w-0 [overflow-wrap:anywhere]">
				if f.Dir != "" {
					<span class="text-muted-2">{ f.Dir }</span>{ f.Short }
				} else {
					{ f.Short }
				}
			</span>
		</p>
	</div>
}

// DepRow is one listed update: name, versions, type chip and copy button. Every row of a file group
// uses the same columns, so they align. Below 600px it stacks into two rows (openspec design D6, mobile first).
templ DepRow(e EntryView, labels rowLabels) {
	<li class="dep-row">
		<code>{ e.Name }</code>
		<span>
			<span class="sr-only">{ labels.Current }</span>{ e.Current } <span aria-hidden="true">→</span> <span class="sr-only">{ labels.New }</span><b>{ e.New }</b>
		</span>
		@TypeChip(e.Type, e.TypeLabel)
		@CopyButton(e.Copy)
	</li>
}

// CopyButton is the icon-only copy button of an entry. Its accessible name and tooltip are the catalog
// label. It shows the clipboard icon, and the check icon while copy.js sets data-state="copied".
templ CopyButton(c CopyView) {
	<button type="button" class="btn icon-btn group" aria-label={ c.Label } title={ c.Label } data-copy={ c.Value }>
		@Icon("copy", "group-data-[state=copied]:hidden")
		@Icon("check", "hidden group-data-[state=copied]:block")
	</button>
}
