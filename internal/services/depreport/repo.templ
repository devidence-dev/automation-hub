package depreport

// RepoGroup is one repo card: a native details without name or open attribute, so each card opens and
// closes on its own (openspec design D4). It starts closed.
templ RepoGroup(g RepoGroupView) {
	<details class="glass group overflow-hidden rounded-[20px]">
		<summary class="flex cursor-pointer list-none flex-wrap items-center gap-3 px-[18px] py-3.5 min-[601px]:flex-nowrap [&::-webkit-details-marker]:hidden">
			@TypeDot(g.Dot)
			<span class="min-w-0 truncate text-[15px] font-semibold">{ g.Short }</span>
			if g.Note != "" {
				<span class="text-xs text-muted">{ g.Note }</span>
			}
			<span class="flex flex-wrap gap-1.5">
				for _, c := range g.Chips {
					@TypeChip(c.Type, c.Text)
				}
			</span>
			@Icon("chevron", "chev ml-auto size-3.5 shrink-0 text-muted")
		</summary>
		<div class="border-t border-line px-[18px]">
			for _, f := range g.Files {
				@FileGroup(f)
			}
		</div>
	</details>
}
