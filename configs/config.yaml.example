# Zone of every schedule and of the dependency report's dates and header. Optional.
timezone: "America/Guayaquil"

server:
  address: ":8080"

# Optional HTTP settings, shown with their defaults. Durations are Go durations ("15s", "3m") and must
# be positive; counts and sizes must be positive too. Telegram's timeout and response_header_timeout
# default to poll_timeout + 10s and poll_timeout + 5s, and must stay above poll_timeout.
# server:
#   read_timeout: "15s"
#   write_timeout: "15s"
#   shutdown_timeout: "30s"
# github:
#   api_url: "https://api.github.com"  # https only; GitHub Enterprise Server uses its /api/v3 base
#   http:
#     timeout: "30s"
#     dial_timeout: "30s"
#     tls_handshake_timeout: "10s"
#     keep_alive: "30s"
#     max_idle_conns: 100
#     idle_conn_timeout: "90s"
#     max_response_bytes: 1048576  # 1 MiB cap on every response body read
# kubernetes:
#   http:
#     timeout: "15s"
#     dial_timeout: "10s"
#     tls_handshake_timeout: "10s"
#     keep_alive: "30s"
#     max_idle_conns: 100
#     idle_conn_timeout: "90s"
#     max_response_bytes: 1048576
# telegram:
#   http:
#     timeout: "40s"                  # whole request, default poll_timeout + 10s
#     dial_timeout: "10s"
#     tls_handshake_timeout: "10s"
#     keep_alive: "30s"
#     max_idle_conns: 100
#     idle_conn_timeout: "90s"
#     poll_timeout: "30s"             # long-poll window sent to Telegram
#     response_header_timeout: "35s"  # default poll_timeout + 5s
#     expect_continue_timeout: "1s"
#     max_attempts: 3                 # attempts per message, minimum 1
#     retry_backoff: "1s"             # doubled after each failed attempt
#     max_retry_after: "30s"          # a 429 asking for a longer wait fails at once

telegram:
  bot_token: "{{TELEGRAM_BOT_TOKEN}}"

workflow_bot:
  # Bot already used by github-runner to notify workflow results.
  bot_token: "{{GITHUB_RUNNER_TELEGRAM_BOT_TOKEN}}"

github:
  token: "{{GITHUB_TOKEN}}"
  # Optional, shown with its default. Base of the run link when GitHub returns no run details.
  # web_url: "https://github.com"

workflows:
  # Optional "schedule" on any entry: a 5-field cron expression (minute hour
  # day-of-month month day-of-week) evaluated in the top-level timezone. The hub
  # dispatches the workflow at those times. Omit it to run only from Telegram.
  - command: "run_cleanup"
    description: "Cleanup unused images"
    owner: "devidence-dev"
    repo: "workflows"
    workflow_file: "ops-github-runner-cleanup.yml"
    ref: "main"
    allowed_chat_ids: ["{{TELEGRAM_ADMIN_CHAT_ID}}"]

restarts:
  # Equivalent to `kubectl rollout restart deployment/github-runner -n infrastructure`.
  # Fixes the stale docker.sock/containerd.sock bind that follows a Docker or k3s
  # package upgrade on the host — the pod needs to remount the current socket.
  - command: "restart_runner"
    description: "Restart the github-runner pod (fixes stale docker/containerd socket)"
    namespace: "infrastructure"
    deployment: "github-runner"
    allowed_chat_ids: ["{{TELEGRAM_ADMIN_CHAT_ID}}"]
# Optional, shown with its defaults: how long a restart waits for the new pods to report
# ready (timeout, must be positive) and how often it checks (poll_interval, must be positive
# and not longer than timeout). Applies to every restart command.
# restart_ready:
#   timeout: "3m"
#   poll_interval: "5s"

jobs:
  # Creates a one-off Kubernetes Job from a suspended CronJob template, like
  # `kubectl create job --from=cronjob/dependency-report -n internal-apps`.
  # Needs RBAC in the homelab repo: cronjobs get + jobs create in the namespace.
  # Optional "schedule" works like it does for workflows.
  - command: "run_dependency_report"
    description: "Run the dependency report (Renovate lookup)"
    namespace: "internal-apps"
    cronjob: "dependency-report"
    allowed_chat_ids: ["{{TELEGRAM_ADMIN_CHAT_ID}}"]
    schedule: "0 9 * * 1"  # Mondays at 09:00

# Enables the dependency report webhook, called by the Job's reporter container
# (multipart: exit_code, pod, log_tail, report; header X-Report-Token). The report
# goes to telegram_chat_id through the "telegram" bot above as ONE message: the HTML
# document dependency-report-<YYYY-MM-DD>.html with a short summary as its caption.
# The caption is kept under Telegram's 1024 characters; if the document cannot be
# sent, the caption is sent as a text message. The document loads its Geist font from
# Google Fonts when opened in a browser; the system font is the fallback.
# Values are Infisical references resolved inside CONFIG_YAML (shown here as ${...} placeholders).
# Do NOT quote the forks reference: it holds a JSON array, so unquoted YAML reads a
# list. Quoting it turns the array into a string and config loading fails.
dependency_report:
  webhook_token: "${DEPENDENCY_REPORT_TOKEN}"
  telegram_chat_id: "{{TELEGRAM_DEPENDENCY_REPORT_CHAT_ID}}"
  forks: ${DEPENDENCY_REPORT_FORKS}  # e.g. ["devidence-dev/discord-tts-bot"]
  # Optional: package files left out of the report, e.g. folders of disabled apps. A path is a
  # file or a folder (everything under it), relative to the repo root.
  # ignore:
  #   - repo: "devidence-dev/homelab"
  #     paths: ["kubernetes/apps/disabled-app"]
  # Optional, shown with their defaults:
  # path: "/webhook/dependency-report"
  # token_header: "X-Report-Token"
  # max_body_bytes: 10485760  # 10 MiB; a larger body gets 413
  # document_name: "dependency-report-{date}.html"  # must contain {date}
  # date_layout: "2006-01-02"  # Go time layout of {date}

# Texts of the Telegram and HTML output. Optional: each key overrides one default text
# (the defaults are in internal/messages/default.yaml). Keep the placeholders ({date}, {count}...).
# messages:
#   caption:
#     header: "🔔 <b>Deps</b> · {date}"
# Bot texts (the defaults are under "bot:" in internal/messages/default.yaml), for example:
# bot:
#   unknown_command: "❔ Comando no existe."

email:
  host: "{{EMAIL_HOST}}"
  port: {{EMAIL_PORT}}
  username: "{{EMAIL_USERNAME}}"
  password: "{{EMAIL_PASSWORD}}"
  polling_interval: 20 # Polling interval in seconds
  # log_preview_length: 200  # Optional: characters of the searched text shown in not-found warnings; must not be negative
  services:
    # Every service needs a non-empty email_from. An empty one would match every sender, so startup fails.
    - name: "cloudflare"
      config:
        email_from: "noreply@notify.cloudflare.com"
        email_subject:
          - "devidence.dev"
        telegram_chat_id: "{{TELEGRAM_CLOUDFLARE_CHAT_ID}}"
        telegram_message: "🛡️ Cloudflare App Code: \n```%s```"
        code_pattern: "\\b\\d{6}\\b"  # the 6-digit code
        # The code sits in the header block, so the headers are kept.
        strip_mime_headers: false
        # mark_as_read: false  # Optional: leave the email unread after processing (default: true)
        # not_found_text: "Not found"  # Optional: sent when no code is found (default: Not found)
    - name: "openai"
      config:
        email_from: "noreply@tm.openai.com"
        email_subject:
          - "Your temporary ChatGPT login code"
          - "Tu código temporal de inicio de sesión de ChatGPT"
        telegram_chat_id: "{{TELEGRAM_OPENAI_CHAT_ID}}"
        telegram_message: "🤖 ChatGPT Code: ```%s```"
        # HTML email body has inline CSS hex colors (e.g. "#202123") that a
        # bare \b\d{6}\b would greedily match before the real code. The
        # leading [^#] + capture group rules those out (see extractor.go's
        # matchCode: it prefers submatch group 1 when the pattern has one).
        code_pattern: "[^#]\\b(\\d{6})\\b"
    - name: "perplexity"
      config:
        email_from: "team@mail.perplexity.ai"
        email_subject:
          - "Sign in to Perplexity"
          - "Inicia sesión en Perplexity"
        telegram_chat_id: "{{TELEGRAM_PERPLEXITY_CHAT_ID}}"
        telegram_message: "🔮 Perplexity Code: ```%s```"
        # The code follows the first marker that occurs, in this order. The
        # candidates are tried on the text after the marker, then code_pattern.
        extractor: marker
        code_markers: ["directly:", "directamente:"]
        code_candidates: ["\\b(\\d{5,6})\\b", "\\b([a-zA-Z0-9]+-[a-zA-Z0-9]+)\\b"]
        code_pattern: "(?:\\d{5,6}|[a-zA-Z0-9]+-[a-zA-Z0-9]+)"

hook:
  - name: "qbittorrent"
    path: "/webhook/qbittorrent"
    config:
      telegram_chat_id: "{{TELEGRAM_QBITTORRENT_CHAT_ID}}"
      telegram_message: "📥 **Download completed successfully!** 🎬 \n🔍 **Name:**  \n%s\n📍 **Path:**  \n%s"
      # max_body_bytes: 1048576  # Optional: body cap in bytes; a larger body gets 413 (default 1 MiB)
  # - name: "other-webhook"
  #   path: "/webhook/other-webhook"
  #   config:
  #     telegram_chat_id: "{{TELEGRAM_OTHER_CHAT_ID}}"
  #     telegram_message: "Custom message: %s"
